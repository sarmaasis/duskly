# Non-secret instance settings. Copy to .env.deploy (ignored by Git).
# Create the database and namespace first; see docs/DEPLOY.md.
D1_DATABASE_ID=
KV_NAMESPACE_ID=
# Use two subdomains of your own domain for reliable session cookies.
WEB_ORIGIN=https://social.example.com
API_ORIGIN=https://api.example.com
EMAIL_FROM="Duskly <noreply@example.com>"
DUSKLY_MODE=selfhost
# Comma-separated emails that may sign in when DUSKLY_MODE=cloud. Empty closes Cloud sign-in.
# CLOUD_TESTER_EMAILS=you@example.com,teammate@example.com
# For CI, supply these as GitHub secrets. Local deployments can use wrangler login.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
