# Better Auth session secret (32+ random bytes)
BETTER_AUTH_SECRET=replace-with-32-plus-bytes
# Public API base URL used as OAuth redirect base (local wrangler default)
BETTER_AUTH_URL=http://localhost:8787
# Angular app origin for CORS, redirects, and invite links
WEB_ORIGIN=http://localhost:4200
# From-address for Cloudflare Email Sending (auth + team invites).
# Domain of the address must be onboarded (duskly.site). Bare addr or Name <addr>.
EMAIL_FROM=Duskly <noreply@duskly.site>
# Encrypts stored network tokens. Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-hex
# Product display name (also set in wrangler.jsonc vars)
APP_NAME=Duskly
# selfhost = limits off / no Cloud billing; cloud = enforce plans via Dodo
DUSKLY_MODE=selfhost

# Dodo Payments — Cloud billing (leave empty for local self-host)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_STANDARD_MONTHLY_PRODUCT_ID=
DODO_STANDARD_YEARLY_PRODUCT_ID=
DODO_TEAM_MONTHLY_PRODUCT_ID=
DODO_TEAM_YEARLY_PRODUCT_ID=
DODO_PRO_MONTHLY_PRODUCT_ID=
DODO_PRO_YEARLY_PRODUCT_ID=
DODO_ULTIMATE_MONTHLY_PRODUCT_ID=
DODO_ULTIMATE_YEARLY_PRODUCT_ID=

# Production OAuth callback for every network:
#   https://api.duskly.site/v1/accounts/oauth/{network}/callback
# Local: ${BETTER_AUTH_URL}/v1/accounts/oauth/{network}/callback

# X (Twitter) OAuth 2.0 — callback https://api.duskly.site/v1/accounts/oauth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# LinkedIn member app — callback https://api.duskly.site/v1/accounts/oauth/linkedin/callback
# Product: Sign In with LinkedIn using OpenID Connect (openid, profile, email).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn Page app — a different LinkedIn app. Callback:
# https://api.duskly.site/v1/accounts/oauth/linkedin-page/callback
# Products: OpenID, Share on LinkedIn, and Community Management
# (rw_organization_admin, w_organization_social, r_organization_social).
LINKEDIN_PAGE_CLIENT_ID=
LINKEDIN_PAGE_CLIENT_SECRET=
# Mastodon: optional override for one instance. Other hosts register via POST /api/v1/apps.
# Callback https://api.duskly.site/v1/accounts/oauth/mastodon/callback
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
MASTODON_INSTANCE=https://mastodon.social
# Meta — Facebook Login app id/secret (Facebook Pages and Page-linked Instagram fallback)
# Callbacks:
#   https://api.duskly.site/v1/accounts/oauth/instagram/callback
#   https://api.duskly.site/v1/accounts/oauth/facebook/callback
# Data deletion: https://api.duskly.site/v1/meta/data-deletion
# Public Instagram media: GET https://api.duskly.site/v1/media/{id}/public?exp=&sig=
META_APP_ID=
META_APP_SECRET=
# Threads API — Threads App ID + App Secret from Meta → Access the Threads API.
# Add this callback in the Threads API settings:
#   https://api.duskly.site/v1/accounts/oauth/threads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=
# Instagram API with Instagram Login — Instagram App ID + App Secret from the Meta app
# (Instagram → API setup with Instagram login). Not META_APP_ID, not the Threads app id,
# not the user's Instagram password. When both are set, Instagram connect uses this path
# (no Facebook Page required). When unset, Instagram falls back to Facebook Login + Page.
# Paste the callback under Instagram → API setup with Instagram login → OAuth redirect URIs
# (not only under Facebook Login):
#   https://api.duskly.site/v1/accounts/oauth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Instagram webhook verify token (Worker secret, not INSTAGRAM_APP_SECRET).
# Meta webhook Callback URL (not the OAuth redirect):
#   https://api.duskly.site/v1/instagram/webhook
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Google OAuth — YouTube upload only. Consent screen scope: https://www.googleapis.com/auth/youtube.upload
# Callback https://api.duskly.site/v1/accounts/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Reddit OAuth (web app) — callback https://api.duskly.site/v1/accounts/oauth/reddit/callback
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Slack OAuth v2 — callback https://api.duskly.site/v1/accounts/oauth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Workers AI model ids (empty = use defaults in code)
# Default: @cf/meta/llama-3.1-8b-instruct-fast
AI_COPILOT_MODEL=
# Default: @cf/black-forest-labs/flux-1-schnell
AI_IMAGE_MODEL=
# Default: lightricks/ltx-2-5-fast (text-to-video)
AI_VIDEO_MODEL=
