{
  "name": "duskly",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source social media scheduler on Cloudflare Workers",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:api": "pnpm --filter @duskly/api dev",
    "dev:web": "pnpm --filter @duskly/web start",
    "build": "pnpm -r build",
    "deploy:api": "pnpm --filter @duskly/api deploy",
    "deploy:web": "pnpm --filter @duskly/web deploy",
    "db:migrate": "pnpm --filter @duskly/api db:migrate",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm test:deploy && pnpm -r test",
    "e2e": "pnpm --filter @duskly/web e2e",
    "duskly": "node scripts/duskly.mjs",
    "setup": "node scripts/setup.mjs",
    "deploy:configure": "node scripts/deploy.mjs configure",
    "deploy:release": "node scripts/deploy.mjs release",
    "deploy:dry-run": "node scripts/deploy.mjs dry-run",
    "test:deploy": "node --test scripts/deploy.test.mjs"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2"
  }
}
