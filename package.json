{
  "name": "sundraft",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source social media scheduler on Cloudflare Workers",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:api": "pnpm --filter @sundraft/api dev",
    "dev:web": "pnpm --filter @sundraft/web start",
    "build": "pnpm -r build",
    "deploy:api": "pnpm --filter @sundraft/api deploy",
    "deploy:web": "pnpm --filter @sundraft/web deploy",
    "db:migrate": "pnpm --filter @sundraft/api db:migrate",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=20"
  }
}
